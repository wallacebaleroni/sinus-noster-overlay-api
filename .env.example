# Intervalo de atualização (segundos) para o refresh em background das APIs externas.
EXTERNAL_DATA_REFRESH_INTERVAL_SECONDS=60

# Tolerância de deslocamento (em graus) para invalidar cache por posição.
# ~0.01 grau equivale a ~1,1 km. Movimento menor que isso reaproveita o cache.
POSITION_CACHE_TOLERANCE_DEG=0.01

# Timeout global das chamadas HTTP em segundos.
EXTERNAL_HTTP_TIMEOUT_SECONDS=8

# Open-Meteo Forecast (vento, temperatura do ar, pressão, sunrise/sunset).
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_FORECAST_ENABLED=1

# Open-Meteo Marine (ondas, correntes, temperatura da água, nível do mar/maré).
OPEN_METEO_MARINE_URL=https://marine-api.open-meteo.com/v1/marine
OPEN_METEO_MARINE_ENABLED=1

# OpenTopoData GEBCO 2020 (batimetria/profundidade). Instância pública limita a
# 1 req/s e 1000 req/dia; considere subir uma instância própria se precisar mais.
OPENTOPODATA_URL=https://api.opentopodata.org/v1/gebco2020
OPENTOPODATA_ENABLED=1

# Nominatim OSM (reverse geocoding). Exige User-Agent identificável por política.
NOMINATIM_URL=https://nominatim.openstreetmap.org/reverse
NOMINATIM_ENABLED=1
NOMINATIM_USER_AGENT=sinus-noster-overlay/1.0 (contato@example.com)
